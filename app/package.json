{
  "name": "bleep",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:hook": "cargo build --release --manifest-path bleep-hook/Cargo.toml && mkdir -p src-tauri/binaries && cp bleep-hook/target/release/bleep-hook src-tauri/binaries/bleep-hook-$(rustc -vV | sed -n 's/^host: //p')",
    "test": "vitest run --dir src",
    "e2e": "playwright test",
    "build:local": "./scripts/install-local.sh",
    "dev:local": "VITE_BLEEP_FLAVOR=local tauri dev --config src-tauri/tauri.local.conf.json --features local"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5",
    "@fontsource/nunito": "^5",
    "@tauri-apps/api": "2.12.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4"
  }
}
