{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bleep",
  "version": "0.3.0",
  "identifier": "site.avirooppaul.bleep",
  "build": {
    "beforeDevCommand": "npm run build:hook && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:hook && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/bleep-hook"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "ScreenRecz Local Signing"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1NUYzMDNDMjdEQTIzMTUKUldRVkk5b25QREJmUlZGUDFGOXIwTzZQNzdTV2FLdElIZUVKSThlUFhCc0tXak5xVkEyZDhBaFkK",
      "endpoints": [
        "https://github.com/AviroopPaul/bleep-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
