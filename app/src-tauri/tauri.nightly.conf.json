{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bleep (nightly)",
  "mainBinaryName": "bleep-nightly",
  "identifier": "site.avirooppaul.bleep.nightly",
  "build": {
    "beforeBuildCommand": "npm run build:hook && VITE_BLEEP_FLAVOR=nightly npm run build"
  },
  "bundle": {
    "icon": [
      "icons-nightly/32x32.png",
      "icons-nightly/128x128.png",
      "icons-nightly/128x128@2x.png",
      "icons-nightly/icon.icns",
      "icons-nightly/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AviroopPaul/bleep/releases/download/nightly/latest-nightly.json"
      ]
    }
  }
}
